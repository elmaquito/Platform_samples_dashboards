---
const { title, src, placeholder = false } = Astro.props;
---
<div class="rounded-lg border bg-white shadow overflow-hidden">
  <h3 class="px-4 py-2 font-semibold border-b">{title}</h3>
  {placeholder
    ? <div class="h-80 flex items-center justify-center text-gray-500">Placeholder local (modèle TMDL dans powerbi-ide/)</div>
    : <iframe src={src} title={title} class="w-full h-80" loading="lazy"></iframe>}
</div>
