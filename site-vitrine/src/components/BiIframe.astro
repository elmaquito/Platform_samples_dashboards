---
const { title, src, placeholder = false, directUrl } = Astro.props;
---
<div class="rounded-xl border border-gray-200 bg-white shadow-sm overflow-hidden flex flex-col h-[420px]">
  <div class="px-4 py-3 bg-gray-50 border-b border-gray-200 flex justify-between items-center">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
      <h3 class="font-semibold text-gray-800 text-sm">{title}</h3>
    </div>
    {directUrl && (
      <a
        href={directUrl}
        target="_blank"
        rel="noreferrer noopener"
        class="text-xs text-blue-600 hover:text-blue-800 hover:underline flex items-center gap-1 font-medium"
      >
        Ouvrir ↗
      </a>
    )}
  </div>

  <div class="flex-1 w-full relative bg-gray-50">
    {placeholder ? (
      <div class="h-full w-full p-4 flex flex-col justify-between bg-white text-gray-700">
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <span class="text-xs uppercase tracking-wider text-gray-600 font-semibold">Rapport Power BI Desktop / Service</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-medium">TMDL Versionné</span>
          </div>

          <div class="grid grid-cols-2 gap-3 mt-4">
            <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg">
              <span class="text-xs text-gray-600">Assets Actifs</span>
              <p class="text-xl font-bold text-gray-900 mt-1">1,248</p>
              <span class="text-[11px] text-emerald-600 font-medium">+4.2% vs M-1</span>
            </div>
            <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg">
              <span class="text-xs text-gray-600">Budget Licences</span>
              <p class="text-xl font-bold text-gray-900 mt-1">18.4 k€</p>
              <span class="text-[11px] text-amber-600 font-medium">92% alloué</span>
            </div>
          </div>

          <!-- Mock Chart SVG -->
          <div class="mt-4 p-3 bg-slate-50 border border-slate-200 rounded-lg">
            <span class="text-xs text-gray-600 font-medium mb-2 block">Répartition par pôle</span>
            <svg class="w-full h-20" viewBox="0 0 300 80" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="20" y="20" width="35" height="50" rx="2" fill="#3B82F6" />
              <rect x="75" y="10" width="35" height="60" rx="2" fill="#2563EB" />
              <rect x="130" y="35" width="35" height="35" rx="2" fill="#60A5FA" />
              <rect x="185" y="25" width="35" height="45" rx="2" fill="#93C5FD" />
              <rect x="240" y="45" width="35" height="25" rx="2" fill="#BFDBFE" />
              <line x1="10" y1="72" x2="290" y2="72" stroke="#CBD5E1" stroke-width="1.5" />
            </svg>
          </div>
        </div>

        <p class="text-xs text-gray-600 text-center italic mt-2">
          Définition sémantique as Code stockée dans <code class="text-xs bg-gray-100 px-1 py-0.5 rounded text-gray-700">powerbi-ide/model.tmdl</code>
        </p>
      </div>
    ) : (
      <iframe
        src={src}
        title={title}
        class="w-full h-full border-0"
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
      />
    )}
  </div>
</div>
