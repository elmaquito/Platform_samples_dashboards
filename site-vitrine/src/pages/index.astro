---
import BiIframe from '../components/BiIframe.astro';
import Scorecard from '../components/Scorecard.astro';
import Slider from '../components/Slider.jsx';

const slides = [
  { title: 'Grafana', text: 'Provisioning 100% YAML/JSON : datasource et dashboard versionnés (IaC).' },
  { title: 'Metabase', text: 'Configuration via scripts API, interface self-service pour les métiers.' },
  { title: 'Power BI', text: 'Modèle sémantique as code (TMDL), rapports côté Desktop/Service.' },
];
const scorecards = [
  { tool: 'Grafana', scores: { 'IaC / OaC': 5, 'Self-service': 3, 'Temps réel': 5 } },
  { tool: 'Metabase', scores: { 'IaC / OaC': 3, 'Self-service': 5, 'Temps réel': 3 } },
  { tool: 'Power BI', scores: { 'IaC / OaC': 3, 'Self-service': 4, 'Temps réel': 3 } },
];
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Vitrine BI — Parc &amp; Assets</title>
  </head>
  <body class="bg-gray-50 text-gray-900">
    <main class="max-w-6xl mx-auto p-6 space-y-8">
      <h1 class="text-3xl font-bold">Vitrine BI &amp; SI — Parc &amp; Assets</h1>
      <p>Comparaison de Grafana, Metabase et Power BI sur la gestion du matériel et des licences.</p>
      <Slider client:load slides={slides} />
      <section class="grid md:grid-cols-3 gap-4">
        <BiIframe title="Grafana" src="http://localhost:3000/d/parc-assets?kiosk" />
        <BiIframe title="Metabase" src="http://localhost:3001" />
        <BiIframe title="Power BI" placeholder />
      </section>
      <section class="grid md:grid-cols-3 gap-4">
        {scorecards.map((c) => <Scorecard {...c} />)}
      </section>
    </main>
  </body>
</html>
