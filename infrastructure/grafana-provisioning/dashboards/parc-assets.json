      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "parc-assets-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(round((count(*) FILTER (WHERE status = 'in_use')::numeric / nullif(count(*) FILTER (WHERE status != 'retired'), 0)::numeric) * 100, 1), 0) AS taux_dispo FROM marts.mart_assets_overview WHERE ('$department' = 'All' OR department = '$department')"
        }
