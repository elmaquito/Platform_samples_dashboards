      "title": "Taux de disponibilité opérationnelle du parc",
      "type": "gauge",
      "datasource": {
        "type": "postgres",
        "uid": "parc-assets-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 85
              }
            ]
          }
        }
